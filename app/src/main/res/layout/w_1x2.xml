<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent">
<ImageView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/w_round" android:importantForAccessibility="no" />
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal" android:padding="10dp">
<ImageView android:id="@+id/w_icon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_w_cloudsun" android:importantForAccessibility="no" />
<TextView android:id="@+id/w_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="24sp" android:textStyle="bold" android:textColor="#0E1A2B" android:includeFontPadding="false" android:layout_marginTop="2dp"/>
<TextView android:id="@+id/w_note" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#0E1A2B" android:includeFontPadding="false" android:maxLines="1"/>
<View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
<FrameLayout android:id="@+id/w_i1_box" android:layout_width="34dp" android:layout_height="34dp"><ImageView android:id="@+id/w_i1_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/w_round_mid" android:importantForAccessibility="no" /><ImageView android:id="@+id/w_i1" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_g_jacket" android:importantForAccessibility="no" /></FrameLayout>
<View android:layout_width="1dp" android:layout_height="6dp" />
<FrameLayout android:id="@+id/w_i2_box" android:layout_width="34dp" android:layout_height="34dp"><ImageView android:id="@+id/w_i2_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/w_round_mid" android:importantForAccessibility="no" /><ImageView android:id="@+id/w_i2" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_g_jacket" android:importantForAccessibility="no" /></FrameLayout>
<TextView android:id="@+id/w_l2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textStyle="bold" android:textColor="#0E1A2B" android:includeFontPadding="false" android:layout_marginTop="4dp" android:maxLines="1"/>
</LinearLayout>
</FrameLayout>
