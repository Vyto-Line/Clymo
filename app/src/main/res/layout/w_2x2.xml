<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent">
<ImageView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/w_round" android:importantForAccessibility="no" />
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
<TextView android:id="@+id/w_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="34sp" android:textStyle="bold" android:textColor="#0E1A2B" android:includeFontPadding="false" android:layout_width="0dp" android:layout_weight="1"/>
<ImageView android:id="@+id/w_icon" android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_w_cloudsun" android:importantForAccessibility="no" />
</LinearLayout>
<View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
<TextView android:id="@+id/w_item1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp" android:textStyle="bold" android:textColor="#0E1A2B" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>
<TextView android:id="@+id/w_note" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#0E1A2B" android:includeFontPadding="false" android:maxLines="2" android:layout_marginTop="2dp"/>
</LinearLayout>
</FrameLayout>
